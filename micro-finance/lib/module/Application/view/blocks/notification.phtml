<?php

use Model\Notification;
use Web\Core\Registry;

$unread = 0;
$layoutVariables = $this->view->getVariable('layoutVariables');
$session = $layoutVariables['session'];

$model = new Notification();
$sql = $model->getSql();
$sql->whereId('administrator_id', $session->getId())
    ->whereId('site_id', Registry::get('site_id'));
$total = $model->selectTotal($sql->getWhere());

if ($total > 0) {
    $sql->whereZero('viewed');
    $unread = $model->selectTotal($sql->getWhere());
}

