<?php

$filters = $this->view->getVariable('filters');
$generator = $this->view->getVariable('generator');
$report = $generator->report();
$list = $report['list'];
$members = $report['members'];
$summary = $report['summary'];
$fields = ['fmc', 'instalment'];
$queryParams = [];
foreach ($fields as $field) {
    $value = $filters->getValue($field);
    if ($value > 0) {
        $queryParams[$field] = $value;
    }
}

$params = '';
if (! empty($queryParams)) {
    $params = '/?' . $this->view->escapeHtml(http_build_query($queryParams));
}

