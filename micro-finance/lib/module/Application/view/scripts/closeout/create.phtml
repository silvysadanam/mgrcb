	else {
	  if (myvalue > 0) { differ = myvalue + .005; }
	}

	re = /\./;
	index = differ.toString().search(re);

	if (index!=-1) { differ = parseFloat(differ.toString().substr(0,index+3)); }

	return differ;
}	
                
function roundFloat(value)
{
	value=Math.round(parseFloat(value)*100)/100;

	value_str=value.toString();

	if (value_str == "NaN") {
    value = 0;
		value_str = "0";
	}
		
	index=value_str.search(/\./);
	
	if (value_str.substr(index,1)!=".") { value+=".00"; }
	else if (value_str.substr(index+1,1)=="") { value+=".00"; }
	else if (value_str.substr(index+2,1)=="") { value+=".00"; }

	return value;
}

