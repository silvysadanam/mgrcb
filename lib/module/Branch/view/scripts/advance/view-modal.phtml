<?php

use Web\Utility\DateHelper;

$store = $this->view->getVariable('store');
$advance = $store->advance();

$date = DateHelper::getDateTime($advance->advance_date);
$date->modify('+1 day');
$minDate = $date->format(DateHelper::DATEPICKER);
$lastPaymentDate = '--';
$repayments = $store->repayments();
if (! empty($repayments)) {
    $last = end($repayments);
    $lastDate = DateHelper::getDateTime($last->payment_date);
    $lastPaymentDate = $lastDate->format(DateHelper::DATEPICKER);
    $lastDate->modify('+1 day');
    $minDate = $lastDate->format(DateHelper::DATEPICKER);
}

