// Format dates consistently as DD/MM/YYYY
$fmtDate = function ($date) {
    if (empty($date)) {
        return '';
    }

    $timestamp = strtotime((string) $date);

    return $timestamp !== false
        ? date('d/m/Y', $timestamp)
        : (string) $date;
};


