$maskAadhar = function ($value) {
    $digits = preg_replace('/\D+/', '', (string) $value);
    if ($digits === '') {
        return '';
    }
    if (strlen($digits) <= 4) {
        return $digits;
    }
    $masked = str_repeat('X', strlen($digits) - 4) . substr($digits, -4);
    // group as 4-4-4 for readability
    return trim(chunk_split($masked, 4, ' '));
};
